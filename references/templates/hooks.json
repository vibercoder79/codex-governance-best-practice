{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/pre_tool_use_guard.py",
            "timeout": 30,
            "statusMessage": "Checking command safety / Pruefe Kommando-Sicherheit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/stop_summary_check.py",
            "timeout": 30,
            "statusMessage": "Checking completion quality / Pruefe Abschlussqualitaet"
          }
        ]
      }
    ]
  }
}
